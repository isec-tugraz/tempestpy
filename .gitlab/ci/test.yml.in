# Pipeline for building and testing TempestPy, generated by the `prepare` job of
# .gitlab-ci.yml, which fills in the image of the pinned Tempest commit.

# Without this, GitLab applies its default job filter (branches and tags) to a child
# pipeline of a merge request pipeline and the child pipeline would be empty.
workflow:
  rules:
    - when: always

stages:
  - test

default:
  tags:
    - heavy-build

variables:
  BUILD_THREADS: "4"
  # Keep in sync with the carl-parser version Tempest's Carl is compatible with.
  CARL_PARSER_REF: "master"

tests:
  stage: test
  image: __TEMPEST_IMAGE__
  timeout: 2h
  script:
    # carl-parser needs Maven and uuid-dev, tempestpy needs python
    - apt-get update -qq
    - apt-get install -y --no-install-recommends maven uuid-dev python3 python3-dev python3-venv
    - export CCACHE_DIR=/ccache CCACHE_BASEDIR="$CI_PROJECT_DIR" CCACHE_MAXSIZE=20G
    # carl-parser, built against the Carl of the Tempest build
    - git clone --depth 1 --branch "$CARL_PARSER_REF" https://github.com/stormchecker/carl-parser.git /opt/carl-parser
    - >
      cmake -S /opt/carl-parser -B /opt/carl-parser/build
      -DCMAKE_BUILD_TYPE=Release -DPORTABLE=ON
      -Dcarl_DIR="$TEMPEST_BUILD_DIR/_deps/carl-build"
    - cmake --build /opt/carl-parser/build --target carl-parser -j "$BUILD_THREADS"
    # TempestPy against the existing Tempest build. Fetching is off, so that a mismatch
    # fails instead of silently building Tempest. STORM_STRICT makes a wrong commit or a
    # dirty build an error.
    - python3 -m venv /opt/venv
    - . /opt/venv/bin/activate
    - >
      pip install -v ".[test]"
      --config-settings=cmake.define.STORM_DIR_HINT="$TEMPEST_BUILD_DIR"
      --config-settings=cmake.define.ALLOW_STORM_FETCH=OFF
      --config-settings=cmake.define.STORM_STRICT=ON
      --config-settings=cmake.define.CARLPARSER_DIR_HINT=/opt/carl-parser/build/
      --config-settings=cmake.define.CMAKE_BUILD_PARALLEL_LEVEL="$BUILD_THREADS"
    - ccache -s
    - pytest tests
