# Dockerfile for the TempestPy image
####################################
# Image with Tempest and TempestPy (stormpy + tempestpy) installed in a virtual
# environment at /opt/venv, which is on the PATH. Meant to be used directly or as a
# base image:
#   FROM <registry>/trustedai/tempestpy:latest
#   RUN pip install gymnasium ...
#
# It is built on the Tempest build image of the commit pinned in pyproject.toml
# (see .gitlab-ci.yml), because TempestPy is linked against that build tree:
#   docker build -f Dockerfile.release \
#     --build-arg TEMPEST_IMAGE=<registry>/trustedai/tempest/build:<commit> .
#
# Requires BuildKit (bind and cache mounts).

ARG TEMPEST_IMAGE
FROM $TEMPEST_IMAGE
LABEL org.opencontainers.image.title="tempestpy"

# Commit of Tempest that the image is built on (recorded as label only)
ARG TEMPEST_COMMIT=""
LABEL io.tempestpy.tempest-commit="$TEMPEST_COMMIT"
# CMake build type
ARG build_type=Release
# Number of threads to use for parallel compilation
ARG no_threads=4
# Keep in sync with the carl-parser version Tempest's Carl is compatible with.
ARG CARL_PARSER_REF=master

# carl-parser needs Maven and uuid-dev, TempestPy needs Python
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends maven uuid-dev python3 python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Build carl-parser against the Carl of the Tempest build
RUN git clone --depth 1 --branch "$CARL_PARSER_REF" https://github.com/stormchecker/carl-parser.git /opt/carl-parser \
    && cmake -S /opt/carl-parser -B /opt/carl-parser/build \
        -DCMAKE_BUILD_TYPE=$build_type -DPORTABLE=ON \
        -Dcarl_DIR="$TEMPEST_BUILD_DIR/_deps/carl-build" \
    && cmake --build /opt/carl-parser/build --target carl-parser -j "$no_threads"

ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Build and install TempestPy against the existing Tempest build. Fetching is off and
# STORM_STRICT is on, so that a mismatching Tempest build fails instead of being rebuilt.
# The source is only needed for the build and is not kept in the image.
# ccache lives in a BuildKit cache mount, which persists between builds on the same Docker host.
RUN --mount=type=bind,target=/src,rw \
    --mount=type=cache,target=/ccache \
    export CCACHE_DIR=/ccache CCACHE_BASEDIR=/src CCACHE_MAXSIZE=20G \
    && pip install -v /src \
        --config-settings=cmake.define.STORM_DIR_HINT="$TEMPEST_BUILD_DIR" \
        --config-settings=cmake.define.ALLOW_STORM_FETCH=OFF \
        --config-settings=cmake.define.STORM_STRICT=ON \
        --config-settings=cmake.define.CARLPARSER_DIR_HINT=/opt/carl-parser/build/ \
        --config-settings=cmake.build-type=$build_type \
        --config-settings=cmake.define.CMAKE_BUILD_PARALLEL_LEVEL="$no_threads" \
    && ccache -s

# Smoke test: the extension modules load and find their libraries
RUN python -c "import stormpy, stormpy.pomdp, tempestpy; print(stormpy.__version__)"

WORKDIR /workspace
